{
  "manifest_version": 3,
  "name": "Focus Group Scanner",
  "version": "0.5.0",
  "description": "Aggregates paid research study opportunities from recruiter sites.",
  "key": "",
  "permissions": ["alarms", "storage", "tabs", "tabGroups", "scripting", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
